<div class="review" id="review-3274276">
    <!--START REVIEW LEFT CONTENT-->
    <div class="review-side">
        <div class="avatar-container-general ">
            <img alt="AkumetsuTime" class="img-circle" data-type="avatar" onError="this.onerror=null; this.src=&#x27;/dist/img/anon.jpg&#x27;" onLoad="this.dataset.loaded = 1" src="https://www.royalroadcdn.com/public/avatars/avatar-223676.png?time=1621479158"></img>
                <div class="avatar-border gold gold-3"></div>
