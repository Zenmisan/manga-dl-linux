	.vb-custom-captcha-shell{max-width:430px;margin:0 auto;color:#f1f1f1}
	.vb-custom-captcha-target{display:flex;justify-content:center;margin:2px auto 18px}
	.vb-custom-captcha-target-canvas{display:block;width:90px;height:90px}
	.vb-custom-captcha-instruction{margin:0 0 18px;font-size:18px;line-height:1.35;color:#fff;text-wrap:balance}
	.vb-custom-captcha-attempts{margin:-8px 0 16px;font-size:14px;line-height:1.3;color:#9aa}
	.vb-custom-captcha-options{position:relative;display:grid;grid-template-columns:repeat(3,90px);width:306px;margin:0 auto;gap:18px}
	.vb-custom-captcha-grid-line{position:absolute;z-index:0;pointer-events:none;background:rgba(255,255,255,.16);border-radius:999px}
	.vb-custom-captcha-grid-line-v1,.vb-custom-captcha-grid-line-v2{top:-8px;width:1px;height:214px}
	.vb-custom-captcha-grid-line-v1{left:99px}
	.vb-custom-captcha-grid-line-v2{left:207px}
	.vb-custom-captcha-grid-line-h{left:-14px;top:99px;width:334px;height:1px}
	.vb-custom-captcha-option{position:relative;z-index:1;width:90px;height:90px;padding:0;border:0;background:transparent;box-shadow:none;cursor:pointer;transition-property:transform,opacity;transition-duration:150ms;transition-timing-function:ease-out}
	.vb-custom-captcha-option:hover,.vb-custom-captcha-option:focus{outline:none;transform:translateY(-1px);opacity:.9}
	.vb-custom-captcha-option:active{transform:scale(.96)}
	.vb-custom-captcha-option img{display:block;width:90px;height:90px}
	.vb-custom-fallback-slot{margin-top:10px;min-height:24px;visibility:hidden}
	.vb-custom-fallback{display:inline;color:#4e8cda;text-decoration:underline;background:transparent;border:0;padding:0;font-size:13px;font-weight:400;line-height:1.2}
	.vb-custom-footer{display:table-row}
	.vb-custom-copyright{display:table-cell;height:1%;padding:20px;line-height:20px;text-align:center;font-size:.8em;background:#181818;color:#999}
	@media (max-width:420px){.vb-custom-wrap{padding:12px}.vb-custom-card{max-width:340px}.vb-custom-content{max-width:310px}.vb-custom-captcha-shell{max-width:310px}.vb-custom-captcha-instruction{font-size:16px}.vb-custom-captcha-options{grid-template-columns:repeat(3,82px);width:270px;gap:12px}.vb-custom-captcha-grid-line-v1,.vb-custom-captcha-grid-line-v2{top:-7px;height:190px}.vb-custom-captcha-grid-line-v1{left:88px}.vb-custom-captcha-grid-line-v2{left:182px}.vb-custom-captcha-grid-line-h{left:-12px;top:88px;width:294px}.vb-custom-captcha-option{width:82px;height:82px}.vb-custom-captcha-option img{width:82px;height:82px}}
