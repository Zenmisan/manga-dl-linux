	<script type="text/javascript">
	(function() {
		function vbCustomCaptchaDecodeTarget() {
			const canvas = document.getElementById('vb-custom-captcha-target');
			const objectUrlApi = window.URL || window.webkitURL;
			if (!canvas || !window.atob || !window.Blob || !objectUrlApi) {
				return;
			}

			const payload = canvas.getAttribute('data-payload') || '';
			const key = canvas.getAttribute('data-key') || '';
			if (payload === '' || key === '') {
				return;
			}

			let binary = '';
			try {
				binary = window.atob(payload);
			} catch (e) {
				return;
			}

			const bytes = new Uint8Array(binary.length);
			for (let i = 0; i < binary.length; i++) {
				bytes[i] = binary.charCodeAt(i) ^ key.charCodeAt(i % key.length);
			}

			const blob = new Blob([bytes], {type: canvas.getAttribute('data-mime') || 'image/jpeg'});
			const url = objectUrlApi.createObjectURL(blob);
			const image = new Image();

			image.onload = function() {
				const context = canvas.getContext('2d');
				if (!context) {
					objectUrlApi.revokeObjectURL(url);
					return;
				}

				// Сервер уже отдал готовый кадр 90x90 со всей порчей
				// (vb_custom_captcha_render_target): рисуем его как есть.
				context.clearRect(0, 0, canvas.width, canvas.height);
				context.drawImage(image, 0, 0, canvas.width, canvas.height);
				canvas.removeAttribute('data-payload');
				canvas.removeAttribute('data-key');
				objectUrlApi.revokeObjectURL(url);
			};

			image.onerror = function() {
				objectUrlApi.revokeObjectURL(url);
			};

			image.src = url;
		}

		vbCustomCaptchaDecodeTarget();

		const input = document.getElementById('vb-fp');
		if (!input || !window.crypto || !window.crypto.subtle || !window.TextEncoder) {
			return;
		}

		const canvasFingerprint = function() {
			try {
				const canvas = document.createElement('canvas');
				canvas.width = 220;
				canvas.height = 40;
				const context = canvas.getContext('2d');
				if (!context) {
					return '';
				}

				context.textBaseline = 'top';
				context.font = '16px Arial';
				context.fillStyle = '#f60';
				context.fillRect(0, 0, 220, 40);
				context.fillStyle = '#069';
				context.fillText('vb-fingerprint', 2, 2);
				context.fillStyle = 'rgba(102, 204, 0, 0.7)';
				context.fillText('vb-fingerprint', 4, 4);
				return canvas.toDataURL();
			} catch (e) {
				return '';
			}
		};

		const payload = [
			navigator.userAgent || '',
			navigator.language || '',
			String(screen.width || ''),
			String(screen.height || ''),
			String(new Date().getTimezoneOffset()),
			canvasFingerprint()
		].join('|');

		window.crypto.subtle.digest('SHA-256', new TextEncoder().encode(payload)).then(function(buffer) {
			input.value = Array.from(new Uint8Array(buffer)).map(function(byte) {
				return byte.toString(16).padStart(2, '0');
			}).join('');
		}).catch(function() {});
	})();
	</script>
