    href="https://readhive.org/series/64901/76"
    class="flex items-center justify-center flex-grow px-3 py-2 font-medium text-white transition transform bg-btn-normal rounded shadow hover:bg-btn-normal-hover active:scale-90"
    up-follow
    up-preload
  >
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32" width="24" height="24" fill="none" stroke="currentcolor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" x-show="!loading"><path d="M16 7 C16 7 9 1 2 6 L2 28 C9 23 16 28 16 28 16 28 23 23 30 28 L30 6 C23 1 16 7 16 7 Z M16 7 L16 28" /></svg>
    <template x-if="loading">
      <svg class="animate-spin text-white" xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24">
    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
    <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
</svg>    </template>
    <span class="ml-1">Read</span>
  </a>

  <div
    x-ignore
    ax-load
    x-data="button('user_reading', 64901, '1a99a4e98b')"
    class="relative flex flex-grow"
  >
    <button
      x-init="dispatch('', 'check', '2a1c0dbeba')"
      @click.prevent="$dispatch('readinglist')"
      class="flex items-center ml-2 flex-grow justify-center px-3 py-2 font-medium text-white transition transform bg-red-600 rounded shadow hover:bg-red-800 active:scale-90"
    >
      <svg :class="data.selected !== null && 'fill-white'" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32" width="24" height="24" fill="none" stroke="currentcolor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" x-show="!loading"><path d="M4 16 C1 12 2 6 7 4 12 2 15 6 16 8 17 6 21 2 26 4 31 6 31 12 28 16 25 20 16 28 16 28 16 28 7 20 4 16 Z"></path></svg>
      <template x-if="loading">
        <svg class="animate-spin text-white" xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24">
    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
    <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
</svg>      </template>
      <span class="ml-1">Add to Library</span>
    </button>
    
          <div
  x-data
  @readinglist.window="$toast('You must be logged in to perform this action.')"
></div>
      </div>
</div>
  </div>
</section>

<div
  x-data="{show:false}"
  @enlarge.window="show = true; src = $event.detail.src"
  x-show="show"
  x-cloak
>
  <template x-if="show">
    <div class="w-full h-full p-8 grid fixed top-0 left-0 place-items-center z-20">
      <div class="w-full max-w-[27rem] aspect-w-9 aspect-h-4">
        <img @click.outside="show = false" :src="src" alt="Solo For Two enlarged cover" class="overlay">
      </div>
    </div>
  </template>
</div>
        </main>

      <div
  x-ignore
  ax-load="idle"
  x-data="toast"
  class="fixed right-0 z-10 flex flex-col top-16"
  @toast.window="add($event.detail)"
  >
  <template x-for="toast of toasts" :key="toast.id">
    <button
      x-show="visibles.includes(toast)"
      x-transition:enter="transition ease-in duration-200"
			x-transition:enter-start="transform opacity-0 translate-y-2"
			x-transition:enter-end="transform opacity-100"
			x-transition:leave="transition ease-out duration-500"
			x-transition:leave-start="transform translate-x-0 opacity-100"
			x-transition:leave-end="transform translate-x-full opacity-0"
      @click="remove(toast.id)"
      type="button"
      :class="toast.success ? 'bg-green-400 hover:bg-green-500' : 'bg-red-400 hover:bg-red-500'"
      class="max-w-xs px-4 py-2 mx-4 mb-4 text-white transition rounded-md"
      >
      <div class="flex space-x-2">
        <template x-if="toast.success">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32" width="24" height="24" fill="none" stroke="currentcolor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" class="flex-shrink-0"><path d="M14 21.414l-5-5.001L10.413 15 14 18.586 21.585 11 23 12.415l-9 8.999zM16 2a14 14 0 1 0 14 14A14 14 0 0 0 16 2zm0 26a12 12 0 1 1 12-12 12 12 0 0 1-12 12z"/></svg>
        </template>

        <template x-if="!toast.success">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"><path d="M20.618 5.984A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016zM12 9v2m0 4h.01"></path></svg>
        </template>
        <p class="font-medium text-left" x-text="toast.message"></p>
      </div>
    </button>
  </template>
</div>

<div x-data="{fixed:true}" x-ref="bottom" class="fixed z-20 m-1 bottom-0 transform translate-x-1/2 right-1/2">
  <div class="relative text-center">
    
  </div>
</div>
    </div>
  </div>
</div>
    </div>

