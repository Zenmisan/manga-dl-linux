: 0.9rem;"></i>'; } } let contentHTML = ''; if (rating.content && rating.content.trim()) { contentHTML = '<div class="rating-content" style="border: solid 1px #1e293b; border-radius:10px; padding: 1rem; background: var(--secondary);"><p style="margin: 0; line-height: 1.5;">' + escapeHtml(rating.content) + '</p></div>'; } var htmlString = '<div class="rating-item mb-4 p-3" style="display: block; width: 100%; clear: both;">'; htmlString += '<div class="rating-header mb-2" style="display: flex; justify-content: space-between; align-items: center;">'; htmlString += '<div class="rater-info">'; htmlString += '<strong style="color: #f7eded;">' + (rating.username || 'Anonymous User'); htmlString += '<div class="text-muted" style="font-size: 0.85rem;">' + formattedDate + '</div>'; htmlString += '</div>'; htmlString += '<div class="user-rating">' + starsHTML; htmlString += '<span class="ml-1" style="font-size: 0.9rem; color: #adb5bd;">' + userRating.toFixed(1) + '</span>'; htmlString += '</div>'; htmlString += '</div>'; htmlString += contentHTML; htmlString += '</div>'; return htmlString; } function escapeHtml(text) { const map = { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#039;' }; return text.replace(/[&<>"']/g, function(m) { return map[m]; }); } }); </script>  <script> (function () { var ref = document.referrer; var currentHost = "bato1.com"; if (ref && ref.includes(currentHost) && !location.href.includes(currentHost)) { gtag('event', 'suspicious_redirect', { from: ref, to: location.href }); } })(); </script> <script src="/assets/js/auth.js?id=c804ae28b9a76c12b0fc" defer></script>  <script> (function() { var GEO_KEY = 'user_country'; var cached = null; try { cached = sessionStorage.getItem(GEO_KEY); } catch(e) {} var tracePromise = null; if (!cached) { var ctrl = typeof AbortController !== 'undefined' ? new AbortController() : null; var timer = ctrl ? setTimeout(function() { ctrl.abort(); }, 3000) : null; tracePromise = fetch('/cdn-cgi/trace', { signal: