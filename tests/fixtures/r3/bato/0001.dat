fa-xs"></i> <span>Filter</span> <i class="ml-2 bi bi-intersect"></i> </button> </div> </div> </form> <script> function updateFilterPlaceholder({inputSelector, labelSelector, placeholderSelector, defaultText, isRadio = false}) { const inputs = document.querySelectorAll(inputSelector + (isRadio ? ':checked' : ':checked')); let selected = []; if (isRadio) { inputs.forEach(input => { const label = document.querySelector(`${labelSelector}[for="${input.id}"]`); if (label) selected.push(label.getAttribute('data-name')); }); } else { selected = Array.from(inputs).map(input => { const label = document.querySelector(`${labelSelector}[for="${input.id}"]`); return label ? label.getAttribute('data-name') : ''; }).filter(Boolean); } const placeholder = document.querySelector(placeholderSelector); if (placeholder) { if (selected.length === 0) { placeholder.textContent = defaultText; } else if (isRadio) { placeholder.textContent = selected[0]; } else if (selected.length === 1) { placeholder.textContent = selected[0]; } else { placeholder.textContent = `${selected.length} selected`; } } } function attachFilterEvents() { [ { inputSelector: '.type-checkbox', labelSelector: 'label', placeholderSelector: '#filters [data-placeholder=\"Type\"]', defaultText: 'Type' }, { inputSelector: '.genre-checkbox', labelSelector: 'label', placeholderSelector: '#filters [data-placeholder=\"Genre\"]', defaultText: 'Genre' }, { inputSelector: 'input[name=\"status[]\"]', labelSelector: 'label', placeholderSelector: '#filters [data-placeholder=\"Status\"]', defaultText: 'Status' }, { inputSelector: 'input[name=\"year[]\"]', labelSelector: 'label', placeholderSelector: '#filters [data-placeholder=\"Year\"]', defaultText: 'Year' }, { inputSelector: 'input[name=\"minchap\"]', labelSelector: 'label', placeholderSelector: '#filters [data-placeholder=\"Length\"]', defaultText: 'Length', isRadio: true }, { inputSelector: 'input[name=\"sort\"]', labelSelector: 'label', placeholderSelector: '#filters [data-placeholder=\"Sort by\"]', defaultText: 'Recently updated', isRadio: true } ].forEach(cfg => { document.querySelectorAll(cfg.inputSelector).forEach(input => { input.addEventListener('change', () => updateFilterPlaceholder(cfg)); }); updateFilterPlaceholder(cfg); }); } attachFilterEvents(); </script> <div class="ads-show desktop" style="text-align: center;padding-top: 10px;"> <a href="https://discord.com/invite/mEa2xD4472" target="_blank" rel="noopener"> <img width="720" height="90" src="/assets/banner/short_720_v2.gif" alt="discord"> </a> </div>   <div class="ads-show mobile" style="text-align: center;"> <a href="https://discord.com/invite/mEa2xD4472" target="_blank" rel="noopener"> <img width="300" height="250" src="/assets/banner/short_720_v2.gif" alt="discord"> </a> </div>   <div class="original card-lg">  <div class="unit item-"> <div class="inner"> <a href="https://bato1.com/manga/one-piece" class="poster"> <div> <img class="lazyload image-thumb" data-src="https://cdn1.love4awalk.xyz/thumb/one-piece.webp" data-fallback="https://cdn1.love4awalk.xyz/thumb/one-piece.webp" alt="One Piece" onerror="handleImageError(this)" referrerpolicy="origin" > </div> </a> <div class="info"> <div>   <a href="https://bato1.com/type/manga" class="type" style="margin-right: 4px;"> Manga </a>  </div> <a href="https://bato1.com/manga/one-piece">One Piece</a> <ul class="content" data-name="chap">  <li> <a href="https://bato1.com/read/one-piece/chapter-1194" title="Chapter 1194"> <span>Chapter 1194</span> <span>14 day ago</span> </a> </li>  <li> <a href="https://bato1.com/read/one-piece/chapter-1193" title="Chapter 1193"> <span>Chapter 1193</span> <span>30 day ago</span> </a> </li>  <li> <a href="https://bato1.com/read/one-piece/chapter-1192" title="Chapter 1192"> <span>Chapter 1192</span> <span>36 day ago</span> </a> </li>  </ul> </div> </div> </div>  <div class="unit item-"> <div class="inner"> <a href="https://bato1.com/manga/doujin-sakka-collection-ketchup" class="poster"> <div> <img class