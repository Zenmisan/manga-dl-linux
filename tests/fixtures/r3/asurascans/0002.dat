ot;value&quot;:true}" await-children><div class="user-menu-skeleton"><div class="user-menu-avatar hidden w-11 min-[460px]:w-[52px] h-[52px] items-center justify-center"><img data-user-menu-skeleton-avatar="true" src="/images/default-pp.webp" alt="" class="h-9 w-9 rounded-full object-cover md:h-10 md:w-10"/></div><div class="user-menu-login"><div class="h-10 w-[85px] rounded-md bg-[#1B1820]"></div></div></div><!--astro:end--></astro-island> </div> <div class="profile-menu-hide notifications-menu-hide"> <astro-island uid="Z1WsBqE" prefix="r49" component-url="/_astro/MobileNav.DV6Cpbes.js" component-export="default" renderer-url="/_astro/client.ZWAiH0lX.js" props="{&quot;navLinks&quot;:[1,[[0,{&quot;name&quot;:[0,&quot;Home&quot;],&quot;href&quot;:[0,&quot;/&quot;]}],[0,{&quot;name&quot;:[0,&quot;Bookmarks&quot;],&quot;href&quot;:[0,&quot;/bookmarks&quot;]}],[0,{&quot;name&quot;:[0,&quot;Browse&quot;],&quot;href&quot;:[0,&quot;/browse&quot;]}]]],&quot;isNovelHome&quot;:[0,false]}" ssr client="load" opts="{&quot;name&quot;:&quot;MobileNav&quot;,&quot;value&quot;:true}" await-children><button class="asura-mobile-button p-2 items-center justify-center rounded-md hover:bg-black/20 transition-colors" aria-label="Navigation menu"><svg class="w-6 h-6 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path></svg></button><!--astro:end--></astro-island> </div> </div> </div> </div> </div> </header> <script>
  (() => {
    if (document.documentElement.dataset.novelBeta !== "1") {
      document.querySelector("[data-content-bookmarks-link]")?.setAttribute("href", "/bookmarks");
      return;
    }

    const mode = document.documentElement.dataset.contentMode === "novels" ? "novels" : "comics";
    const setModeLinkState = (link, active) => {
      if (!link) return;
      link.classList.toggle("bg-white/15", active);
      link.classList.toggle("text-white", active);
      link.classList.toggle("text-white/90", !active);
      link.classList.toggle("hover:bg-white/10", !active);
      link.classList.toggle("hover:text-white", !active);
    };

    const comicsLink = document.querySelector('[data-content-mode-link="comics"]');
    const novelsLink = document.querySelector('[data-content-mode-link="novels"]');
    // Never selected. The link already relabels itself "Home" for the current
    // mode, so a highlight on top of that just read as Home being a permanently
    // selected tab. Passing false also clears the state from cached markup.
    setModeLinkState(comicsLink, false);
    setModeLinkState(novelsLink, false);

    if (comicsLink && novelsLink) {
      comicsLink.textContent = mode === "comics" ? "Home" : "Comics";
      novelsLink.textContent = mode === "novels" ? "Home" : "Novels";

      // The hrefs need correcting here too, not just the labels. This markup is
      // share-cached, so a page rendered for one mode can be read in the other,
      // and the server-side href would then belong to the wrong link.
      //
      // Mirrors contentModeSwitchHref; this script is inline and cannot import
      // it, so the two must be kept in step.
      const switchHref = (target) => {
        const p = window.location.pathname;
        if (p === "/bookmarks" || p.startsWith("/bookmarks/")) return "/bookmarks/" + target;
        if (p === "/browse" || p.startsWith("/browse/")) return "/browse/" + target;
        return target === "novels" ? "/novels" : "/comics";
      };
      comicsLink.setAttribute("href", mode === "comics" ? "/comics" : switchHref("comics"));
      novelsLink.setAttribute("href", mode === "novels" ? "/novels" : switchHref("novels"));
      comicsLink.style.order = mode === "comics" ? "0" : "1";
      novelsLink.style.order = mode === "novels" ? "0" : "1";
      const activeLink = mode === "novels" ? novelsLink : comicsLink;
      const inactiveLink = mode === "novels" ? comicsLink : novelsLink;
      activeLink.parentElement?.insertBefore(activeLink, inactiveLink);
    }

    document.querySelector("[data-content-bookmarks-link]")?.setAttribute(
      "href",
      mode === "novels" ? "/bookmarks/novels" : "/bookmarks/comics",
    );

    document.querySelector("[data-content-home-link]")?.setAttribute(
      "href",
      mode === "novels" ? "/novels" : "/comics",
    );
    document.querySelector('[data-content-nav-link="browse"]')?.setAttribute(
      "href",
      mode === "novels" ? "/browse/novels" : "/browse/comics",
    );
  })();
</script> <script type="module">var e=document.getElementById(`resources-btn`),t=document.getElementById(`resources-menu`),n=document.getElementById(`resources-chevron`);e&&t&&n&&(e.addEventListener(`click`,e=>{e.stopPropagation(),t.classList.toggle(`touch-open`),n.classList.toggle(`touch-open`)}),document.addEventListener(`click`,()=>{t.classList.remove(`touch-open`),n.classList.remove(`touch-open`)}));</script> <astro-island uid="Zv6mTo" prefix="r33" component-url="/_astro/MigrationBanner.C1O45WrT.js" component-export="default" renderer-url="/_astro/client.ZWAiH0lX.js" props="{}" ssr client="load" opts="{&quot;name&quot;:&quot;MigrationBanner&quot;,&quot;value&quot;:true}"></astro-island> <astro-island uid="ZLlNBF" prefix="r34" component-url="/_astro/PaymentFailedBanner.C9DrdR_o.js" component-export="default" renderer-url="/_astro/client.ZWAiH0lX.js" props="{}" ssr client="load" opts="{&quot;name&quot;:&quot;PaymentFailedBanner&quot;,&quot;value&quot;:true}"></astro-island> <script>(()=>{var l=(n,t)=>{let i=async()=>{await(await n())()},e=typeof t.value=="object"?t.value:void 0,s={timeout:e==null?void 0:e.timeout};"requestIdleCallback"in window?window.requestIdleCallback(i,s):setTimeout(i,s.timeout||200)};(self.Astro||(self.Astro={})).idle=l;window.dispatchEvent(new Event("astro:idle"));})();</script><astro-island uid="ZXQymh" prefix="r35" component-url="/_astro/MythicBanner.6I-z7xS_.js" component-export="default" renderer-url="/_astro/client.ZWAiH0lX.js" props="{}" ssr client="idle" opts="{&quot;name&quot;:&quot;MythicBanner&quot;,&quot;value&quot;:true}"></astro-island> <astro-island uid="1PGMe7" prefix="r36" component-url="/_astro/ChargebackBanner.DQ3qh1sP.js" component-export="default" renderer-url="/_astro/client.ZWAiH0lX.js" props="{}" ssr client="load" opts="{&quot;name&quot;:&quot;ChargebackBanner&quot;,&quot;value&quot;:true}"></astro-island> <astro-island uid="27tkpi" prefix="r37" component-url="/_astro/RelinkBanner.CxlCZ48j.js" component-export="default