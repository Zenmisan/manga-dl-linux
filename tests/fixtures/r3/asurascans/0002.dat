nt side. Neutral pages such as
         404s can then return the reader to the same comics or novels experience. --><script>
      (() => {
        try {
          const cookieEnabled = document.cookie
            .split(";")
            .some((part) => part.trim() === "novel_beta=1");
          // Mirrors stores/novelBeta.ts: novels are on for everyone and only an
          // explicit "0" turns them off. This has to agree with that store, or
          // readers get a frame of comics-only navigation before hydration —
          // and the homepage reads this same flag to bounce off /comics.
          const optedOut = localStorage.getItem("novel-beta-enabled") === "0";
          const betaActive = !optedOut;
          document.documentElement.dataset.novelBeta = betaActive ? "1" : "0";

          if (!betaActive) {
            document.documentElement.dataset.contentMode = "comics";
            return;
          }

          if (!cookieEnabled) {
            document.cookie = "novel_beta=1;path=/;max-age=31536000;SameSite=Lax";
          }

          const path = window.location.pathname;
          const params = new URLSearchParams(window.location.search);
          const type = params.get("type");
          const bookmarkTab = params.get("tab");
          let explicitMode = null;

          if (
            path === "/novels" ||
            path.startsWith("/novels/") ||
            path === "/browse/novels" ||
            path === "/bookmarks/novels" ||
            (path === "/browse" && type === "novel") ||
            (path === "/bookmarks" && (type === "novel" || bookmarkTab === "novels"))
          ) {
            explicitMode = "novels";
          } else if (
            path === "/comics" ||
            path.startsWith("/comics/") ||
            path === "/browse/comics" ||
            path === "/bookmarks/comics" ||
            (path === "/browse" && (type === "all" || type === "comic")) ||
            (path === "/bookmarks" && (type === "comic" || bookmarkTab === "comics"))
          ) {
            explicitMode = "comics";
          }

          if (explicitMode) {
            localStorage.setItem("asura-content-mode", explicitMode);
          }

          const savedMode = localStorage.getItem("asura-content-mode");
          const resolvedMode =
            explicitMode || (savedMode === "novels" ? "novels" : "comics");
          document.documentElement.dataset.contentMode = resolvedMode;

          // Upgrade old beta links to canonical content routes. Query strings
          // remain reserved for actual filters, sorting, and pagination.
          if (
            path === "/browse" &&
            (type === "novel" || type === "all" || type === "comic")
          ) {
            params.delete("type");
            const destination = new URL(
              type === "novel" ? "/browse/novels" : "/browse/comics",
              window.location.origin,
            );
            destination.search = params.toString();
            destination.hash = window.location.hash;
            window.location.replace(
              destination.pathname + destination.search + destination.hash,
            );
            return;
          }

          if (
            path === "/bookmarks" &&
            (type === "novel" ||
              type === "comic" ||
              bookmarkTab === "novels" ||
              bookmarkTab === "comics")
          ) {
            params.delete("type");
            params.delete("tab");
            const destination = new URL(
              type === "novel" || bookmarkTab === "novels"
                ? "/bookmarks/novels"
                : "/bookmarks/comics",
              window.location.origin,
            );
            destination.search = params.toString();
            destination.hash = window.location.hash;
            window.location.replace(
              destination.pathname + destination.search + destination.hash,
            );
            return;
          }

          // A fresh tab enters through "/", which has no server-visible access
          // to localStorage. Resolve it before the homepage renders so the
          // reader returns to their last explicitly selected content side.
          if (path === "/") {
            const rootMode =
              type === "novel" || type === "novels"
                ? "novels"
                : type === "all" || type === "comic" || type === "comics"
                  ? "comics"
                  : resolvedMode;
            const destination = new URL(
              rootMode === "novels" ? "/novels" : "/comics",
              window.location.origin,
            );
            params.delete("type");
            destination.search = params.toString();
            destination.hash = window.location.hash;
            window.location.replace(
              destination.pathname + destination.search + destination.hash,
            );
          }
        } catch {
          // Storage can be unavailable in private or restricted browser contexts.
          document.documentElement.dataset.novelBeta = "0";
          document.documentElement.dataset.contentMode = "comics";
        }
      })();
    </script><style>
      html:not([data-guilds="1"]) .guilds-only {
        display: none !important;
      }
      html:not([data-novel-beta="1"]) .novel-beta-only {
