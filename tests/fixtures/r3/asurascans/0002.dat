    </style><!-- Set has-user class before body renders to prevent skeleton flash --><script>
      try {
        const cachedUser = JSON.parse(localStorage.getItem("user") || "null");
        if (cachedUser) {
          document.documentElement.classList.add("has-user");
          document.documentElement.dataset.cachedUserRole = cachedUser.role || "";
        }
        // Guilds launch switch: admins always, everyone once the API says public.
        if ((cachedUser && cachedUser.role === "admin") || localStorage.getItem("guilds-public") === "1") {
          document.documentElement.dataset.guilds = "1";
