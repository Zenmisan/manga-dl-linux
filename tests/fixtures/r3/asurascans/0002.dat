        var t=e.target;
        if(!t||sessionStorage.getItem("_cr"))return;
        var tag=t.tagName;
        var resourceUrl=tag==="SCRIPT"?t.src:tag==="LINK"&&t.rel==="stylesheet"?t.href:"";
        if(!resourceUrl)return;
        var resource;
        try{resource=new URL(resourceUrl,location.href)}catch{return}
        if(resource.origin===location.origin&&resource.pathname.startsWith("/_astro/")){
          sessionStorage.setItem("_cr","1");
          location.reload();
        }
      },true);
