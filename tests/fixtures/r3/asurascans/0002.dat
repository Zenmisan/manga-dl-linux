      } catch {}
    </script><script type="module" src="/_astro/BaseLayout.astro_astro_type_script_index_0_lang.CTHi1kjH.js"></script><script>
      (() => {
        const isSafari = /Safari/i.test(navigator.userAgent) &&
          !/(CriOS|FxiOS|EdgiOS|OPiOS|Chrome|Chromium|Android)/i.test(navigator.userAgent);
        if (!isSafari) return;

        // Safari can restore an old page snapshot after its hashed stylesheet has been retired.
        window.addEventListener("pageshow", () => {
          requestAnimationFrame(() => {
            const tailwindReady = getComputedStyle(document.documentElement)
              .getPropertyValue("--tw-border-style")
              .trim() === "solid";
            const lastReload = Number(sessionStorage.getItem("asura-safari-style-reload") || 0);
            if (tailwindReady || Date.now() - lastReload < 10_000) return;

            sessionStorage.setItem("asura-safari-style-reload", String(Date.now()));
            window.location.reload();
          });
        });
      })();
    </script><!-- Force body visible after 3s even if CSS fails to load (stale cache) --><script>
      setTimeout(function(){document.body&&(document.body.style.opacity="1")},3000);
    </script><!-- Reload on chunk load errors (stale cached JS after deploy) --><script>
