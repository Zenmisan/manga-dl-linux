umber":199,"cv":1786514006423},{"id":"2KeNdBJY","url":"/mtl-solo-all-around-agent/chapter-198","name":"Chapter 198","slug":"chapter-198","created_at":"2026-08-12T05:53:26.000Z","updated_at":"2026-08-12T05:53:26.000Z","number":198,"cv":1786514006423},{"id":"DwQao008","url":"/mtl-solo-all-around-agent/chapter-197","name":"Chapter 197","slug":"chapter-197","created_at":"2026-08-12T05:53:26.000Z","updated_at":"2026-08-12T05:53:26.000Z","number":197,"cv":1786514006423}],"genres":[{"name":"System","slug":"system"}],"is_published":true,"episode_duration":null,"has_sub":false,"anime_season":null,"ani_id":null,"year_views":40,"is_raw":false,"is_uncensored":false,"is_mtl":true,"has_dub":false,"mal_id":null,"has_dmca":false},{"id":"VYP01EYz","url":"/mtl-emperor-of-solo-play","name":"MTL-Emperor of solo play","match_field":"name","slug":"mtl-emperor-of-solo-play","cover":"https://rs.novelbuddy.me/covers/emperor-of-solo-play.webp","status":"completed","rating":0,"summary":"The world has transformed, and so have its inhabitants. On December 31st, 2016 – the eve of New Year, Kim Taehoon was simply shopping for groceries at a large store. Suddenly, monsters emerged from nowhere. Utilizing the highly skilled training from his past job, he begins to hunt the monsters and succeeds, rescuing numerous individuals who were also in the mall. However, more monsters continue to appear relentlessly. Will he manage to survive until the end? Can he defeat the seemingly ever-stronger monsters? And are monsters the only threat he must face? The adventure of Kim Taehoon, Kim Taehoon The First Hunter, is about to commence.","stats":{"views":6,"day_views":0,"week_views":0,"month_views":0,"bookmarks_count":0,"comments_count":0,"chapters_count":192,"ratings_count":0,"reviews_count":0},"updated_at":"2026-07-22T04:16:26.000Z","cv":1784693786710,"is_new":false,"is_hot":false,"is_adult":false,"cover_censored":false,"latest_chapters":[{"id":"8NvJmol8","url":"/mtl-emperor-of-solo-play/chapter-191-epilogue","name":"Chapter 191 Epilogue","slug":"chapter-191-epilogue","created_at":"2026-07-22T04:16:26.000Z","updated_at":"2026-07-22T04:16:26.000Z","number":192,"cv":1784693786710},{"id":"2ZkJBQg8","url":"/mtl-emperor-of-solo-play/chapter-190-emperor-of-solo-play","name":"Chapter 190 Emperor of Solo Play","slug":"chapter-190-emperor-of-solo-play","created_at":"2026-07-22T04:16:26.000Z","updated_at":"2026-07-22T04:16:26.000Z","number":191,"cv":1784693786710},{"id":"8n4LlQlD","url":"/mtl-emperor-of-solo-play/chapter-189-barbarian-king-6","name":"Chapter 189 Barbarian King (6)","slug":"chapter-189-barbarian-king-6","created_at":"2026-07-22T04:16:24.000Z","updated_at":"2026-07-22T04:16:24.000Z","number":190,"cv":1784693786710}],"genres":[{"name":"Sci-fi","slug":"sci-fi"},{"name":"Comedy","slug":"comedy"},{"name":"Adventure","slug":"adventure"},{"name":"Action","slug":"action"}],"episode_duration":null,"has_sub":false,"anime_season":null,"ani_id":null,"year_views":6,"is_raw":false,"is_uncensored":false,"is_mtl":true,"has_dub":false,"mal_id":null},{"id":"AY3Wm7Yy","url":"/solo-farming-in-the-tower","name":"Solo Farming In The Tower","alt_names":[{"name":"나혼자 탑에서 농사，Farming in the tower alone"}],"alt_name":"나혼자 탑에서 농사，Farming in the tower alone","match_field":"name","slug":"solo-farming-in-the-tower","cover":"https://rs.novelbuddy.me/covers/solo-farming-in-the-tower.png","status":"ongoing","rating":5,"summary":"<p>One day, a mysterious tower suddenly appeared in the city. The people decided to call it a dungeon, and while it was full of rugged terrain and dangerous monsters, it was also a land of opportunity, where countless treasures awaited. When Sejun, a young man living an ordinary life, is invited to the dungeon by chance, he is thrilled at the prospect of becoming rich, but he is stranded in a hidden area of the mysterious tower. All he has is a few seeds and his body. Now Sejun must farm, collect resources, and figure out his own survival strategy!</p>","stats":{"views":57262,"day_views":2,"week_views":196,"month_views":510,"bookmarks_count":114,"comments_count":22,"chapters_count":835,"ratings_count":8,"reviews_count":6,"manga_only_comments_count":1},"updated_at":"2026-03-26T09:45:49.000Z","cv":1791345641070,"is_new":false,"is_hot":false,"is_adult":false,"cover_censored":false,"latest_chapters":[{"id":"8N5kqWm2","url":"/solo-farming-in-the-tower/chapter-835-108-santa-part-time-job-1-832","name":"Chapter 835 - 108: Santa Part-Time Job (1) / 832","slug":"chapter-835-108-santa-part-time-job-1-832","created_at":"2026-03-26T09:45:49.000Z","updated_at":"2026-03-26T09:45:49.000Z","number":835,"cv":1791345641070},{"id":"24WA9JAD","url":"/solo-farming-in-the-tower/chapter-834-107-a-christmas-eve-miracle-2-831","name":"Chapter 834 - 107: A Christmas Eve Miracle (2) / 831","slug":"chapter-834-107-a-christmas-eve-miracle-2-831","created_at":"2026-03-26T09:45:49.000Z","updated_at":"2026-03-26T09:45:49.000Z","number":834,"cv":1791345641070},{"id":"2ZewVMJD","url":"/solo-farming-in-the-tower/chapter-833-106-a-christmas-eve-miracle-1-830","name":"Chapter 833 - 106: A Christmas Eve Miracle (1) / 830","slug":"chapter-833-106-a-christmas-eve-miracle-1-830","created_at":"2026-03-26T09:45:49.000Z","updated_at":"2026-03-26T09:45:49.000Z","number":833,"cv":1791345641070}],"genres":[{"name":"Action","slug":"action"},{"name":"Adventure","slug":"adventure"},{"name":"Supernatural","slug":"supernatural"},{"name":"Fantasy","slug":"fantasy"},{"name":"Slice Of Life","slug":"slice-of-life"}],"episode_duration":null,"has_sub":false,"anime_season":null,"rating_avg":5,"ani_id":null,"rating_count":8,"year_views":6413,"is_raw":false,"is_uncensored":false,"is_mtl":false,"has_dub":false,"mal_id":null,"lists_count":0},{"id":"z8d5KeYR","url":"/solo-cultivating-in-superhero-academy","name":"Solo Cultivating in Superhero Academy","match_field":"name","slug":"solo-cultivating-in-superhero-academy","cover":"https://rs.novelbuddy.me/covers/solo-cultivating-in-superhero-academy.png","status":"ongoing","rating":5,"summary":"“I, an Immortal Cultivator in this world of superheroes, alone understand the Dao.”Elius Northrim had a peaceful life—until he blacked out and awakened with tragic memories of his past life.Along with those memories was a realization that in his eighteen years, he was living in a brutal superhero universe, and his ruthless alien father—whom he had never met and a SUPERMAN equivalent of this world—was coming for his life because one of his brothers, the main character of the comic awakened his Solarion bloodline.Surviving while being mistaken for an awakened Solarion offspring of his father too, Elius must keep the truth hidden—he’s not one of them, but an immortal cultivator.If his father discovers the deception, both he and his mother will die.But the worst part is that he has become his father's favorite among the two. To avoid being constantly under his father's watch, Elius enrolls in a superhero academy, blending in while secretly growing stronger.However, with rival students, watchful instructors, and his father’s looming presence, one mistake could mean death.Now, he must master his powers, play his role, and survive—before his secret is exposed as a lone immortal cultivator in this world of Superheroes.","stats":{"views":892,"day_views":0,"week_views":2,"month_views":2,"bookmarks_count":2,"comments_count":0,"chapters_count":174,"ratings_count":3,"reviews_count":3},"updated_at":"2026-03-18T04:24:42.000Z","cv":1773807882000,"is_new":false,"is_hot":false,"is_adult":false,"cover_censored":false,"latest_chapters":[{"id":"DVLzevd8","url":"/solo-cultivating-in-superhero-academy/chapter-174-worry-free","name":"Chapter 174: Worry free","slug":"chapter-174-worry-free","created_at":"2026-03-18T04:24:42.000Z","updated_at":"2026-03-18T04:24:42.000Z","number":174,"cv":1773807882000},{"id":"8avwkxWY","url":"/solo-cultivating-in-superhero-academy/chapter-173-deduction","name":"Chapter 173: Deduction","slug":"chapter-173-deductio