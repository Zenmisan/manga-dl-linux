":"chapter-1","created_at":"2026-07-31T11:01:51.000Z","updated_at":"2026-07-31T11:01:51.000Z","number":1,"cv":1785495711043}],"is_uncensored":false,"is_raw":false,"is_mtl":true,"has_dmca":false,"is_published":true,"has_sub":false,"has_dub":false,"anime_season":null,"episode_duration":null,"mal_id":null,"ani_id":null},{"id":"PDmv4J2E","url":"/solo-max-level-newbie","name":"Solo Max-Level Newbie","alt_names":[{"name":"나 혼자 만렙 뉴비, I'm the Max-Level Newbie!"}],"alt_name":"나 혼자 만렙 뉴비, I'm the Max-Level Newbie!","match_field":"name","slug":"solo-max-level-newbie","cover":"https://rs.novelbuddy.me/covers/solo-max-level-newbie.png","status":"ongoing","rating":5,"summary":"<p>Jinhyuk, a gaming Nutuber, was the only person who saw the ending of the game [Tower of Trials].</p>\n<p>However, when the game’s popularity declined, it became difficult for him to continue making a living as a gaming Nutuber.</p>\n<p>Since he already saw the ending of the game, he was about to quit playing. But that day, [Tower of Trials] became reality, and Jinhyuk, who knew about every single thing in the game, took over everything faster than anyone possibly could! “I’ll show you what a true pro is like.”</p>","stats":{"views":22532,"day_views":234,"week_views":568,"month_views":802,"bookmarks_count":107,"comments_count":0,"chapters_count":743,"ratings_count":6,"reviews_count":6,"manga_only_comments_count":0},"updated_at":"2025-02-25T15:11:51.000Z","cv":1791450992991,"is_new":false,"is_hot":false,"is_adult":false,"cover_censored":false,"latest_chapters":[{"id":"2ZZeMNm2","url":"/solo-max-level-newbie/chapter-740","name":"Chapter 740","slug":"chapter-740","created_at":"2025-02-25T15:11:51.000Z","updated_at":"2025-02-25T15:11:51.000Z","number":744,"cv":1791450992991},{"id":"DBoQey92","url":"/solo-max-level-newbie/chapter-739","name":"Chapter 739","slug":"chapter-739","created_at":"2025-02-25T15:11:51.000Z","updated_at":"2025-02-25T15:11:51.000Z","number":743,"cv":1791450992991},{"id":"240WJXW2","url":"/solo-max-level-newbie/chapter-738","name":"Chapter 738","slug":"chapter-738","created_at":"2025-02-25T15:11:48.000Z","updated_at":"2025-02-25T15:11:48.000Z","number":742,"cv":1791450992991}],"genres":[{"name":"Action","slug":"action"},{"name":"Adventure","slug":"adventure"},{"name":"Fantasy","slug":"fantasy"},{"name":"Comedy","slug":"comedy"},{"name":"Harem","slug":"harem"}],"episode_duration":null,"has_sub":false,"anime_season":null,"rating_avg":5,"ani_id":null,"rating_count":6,"year_views":5649,"is_raw":false,"is_uncensored":false,"is_mtl":false,"has_dub":false,"mal_id":null,"lists_count":3},{"id":"X08A0V2p","url":"/emperor-of-solo-play","name":"Emperor of Solo Play","alt_names":[{"name":"Esp, Solpeul-ui Jewang, 솔플의 제왕"}],"alt_name":"Esp, Solpeul-ui Jewang, 솔플의 제왕","match_field":"name","slug":"emperor-of-solo-play","cover":"https://rs.novelbuddy.me/covers/emperor-of-solo-play.png","status":"completed","rating":5,"summary":"Year 2035. The virtual reality game, Warlord, changed the world. An Jaehyun was one of the many who wished to change his life through the game. After dedicating his life to the game, he was met with a betrayal. A betrayal by his comrades. As a result, he lost everything. But a chance was given to him. A chance to redo everything again! “I won’t play with others ever again. Whatever the outcome, I’ll show that I can do it alone.” Others rolled a dice to split the spoils of victory. An Jaehyun ate it all by himself. It was the start of An Jaehyun’s solo game life.","stats":{"views":1088767,"day_views":0,"week_views":0,"month_views":28,"bookmarks_count":37,"comments_count":0,"chapters_count":192,"ratings_count":4,"reviews_count":4,"manga_only_comments_count":0},"updated_at":"2023-02-25T13:15:08.000Z","cv":1789108696317,"is_new":false,"is_hot":false,"is_adult":false,"cover_censored":false,"latest_chapters":[{"id":"27waXG12","url":"/emperor-of-solo-play/chapter-191-epilogue","name":"Chapter 191 Epilogue","slug":"chapter-191-epilogue","created_at":