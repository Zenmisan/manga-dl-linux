es-la","en"],"latestUploadedChapter":"adbcc93a-8d00-4a83-bdef-580c18cea626"},"relationships":[{"id":"0df61a33-530c-459a-bbd8-017e994548e7","type":"author"},{"id":"b240e6d7-8c9a-4b6b-8603-f410252f95a2","type":"author"},{"id":"658158c6-037c-449b-991b-902b407b0a94","type":"artist"},{"id":"e57c139d-2557-4d13-bfa5-deb8f1b8522c","type":"cover_art","attributes":{"description":"","volume":"7","fileName":"4b2ed7e5-eb98-4e6e-8fab-ecd1ac4c018d.jpg","locale":"ja","createdAt":"2026-10-08T16:41:19+00:00","updatedAt":"2026-10-08T16:41:19+00:00","version":1}}]},{"id":"5ecc01a9-6874-4cee-b478-7c2a9c590169","type":"manga","attributes":{"title":{"ja-ro":"Ponkotsu Succubus to Bocchi Noroi no Boukensha: Nazeka Dojikko Inma to Musou Suru!"},"altTitles":[{"ja":"\u307d\u3093\u3053\u3064\u30b5\u30ad\u30e5\u30d0\u30b9\u3068\u307c\u3063\u3061\u546a\u3044\u306e\u5192\u967a\u8005\u3000\uff5e\u306a\u305c\u304b\u30c9\u30b8\u3063\u5b50\u6deb\u9b54\u3068\u7121\u53cc\u3059\u308b\uff01\uff5e"},{"en":"The Clumsy Succubus and the Cursed Loner Adventurer"}],"description":{"en":"Theo is a solo adventurer cursed with the \"loner\" curse, making it impossible for him to form a party with anyone. While visiting the remote frontier town of Disbule, where succubi are rumored to be attacking the locals, he gathers information at a tavern. There, he meets Lilya, a young woman dressed in elegant, noble attire that seems completely out of place. After Theo rescues her from a group of drunken men harassing her, she offers to repay him by saying, \"I'll... do something naughty for you,\" and starts taking off her clothes...!?"},"isLocked":false,"links":{"mu":"6ass4gw","amz":"https:\/\/www.amazon.co.jp\/dp\/B0GN7BX9GH","mal":"195659"},"officialLinks":null,"originalLanguage":"ja","lastVolume":"","lastChapter":"","publicationDemographic":"seinen","status":"ongoing","year":2025,"contentRating":"erotica","tags":[{"id":"39730448-9a5f-48a2-85b0-a70db87b1233","type":"tag","attributes":{"name":{"en":"Demons"},"description":{},"group":"theme","version":1},"relationships":[]},{"id":"87cc87cd-a395-47af-b27a-93258283bbc6","type":"tag","attributes":{"name":{"en":"Adventure"},"description":{},"group":"genre","version":1},"relationships":[]}],"state":"published","chapterNumbersResetOnNewVolume":false,"createdAt":"2026-08-11T15:41:11+00:00","updatedAt":"2026-09-06T22:12:48+00:00","version":8,"availableTranslatedLanguages":["en"],"latestUploadedChapter":"78bc86b2-b619-4a59-b2f2-ac2f2a746b08"},"relationships":[{"id":"0388e52b-9fb3-4988-915f-a8bce52dc4bd","type":"author"},{"id":"0388e52b-9fb3-4988-915f-a8bce52dc4bd","type":"artist"},{"id":"ebcc2330-3c18-4132-9c63-7c81a08cd5b8","type":"cover_art","attributes":{"description":"","volume":null,"fileName":"4ee62cef-b74a-45d6-b550-069998ebb406.jpg","locale":"ja","createdAt":"2026-08-11T15:41:14+00:00","updatedAt":"2026-08-11T16:15:32+00:00","version":2}},{"id":"8778b5ee-9dea-434b-a2a1-b9c0145a6875","type":"creator"}]},{"id":"ece511da-3461-421a-8275-7af48a642aa5","type":"manga","attributes":{"title":{"ja-ro":"Bocchi Kaibutsu to Moumoku Shoujo"},"altTitles":[{"ja-ro":"Bocchi Kaibutsu to Moumoku Shoujo"},{"en":"Beauty and the Beast Girl"},{"vi":"Y\u00eau Qu\u00e1i C\u00f4 \u0110\u01a1n V\u00e0 C\u00f4 B\u00e9 B\u1ecb M\u00f9"},{"ru":"\u0421\u043b\u0435\u043f\u0430\u044f \u043a\u0440\u0430\u0441\u0430\u0432\u0438\u0446\u0430 \u0438 \u043e\u0434\u0438\u043d\u043e\u043a\u043e\u0435 \u0447\u0443\u0434\u043e\u0432\u0438\u0449\u0435"},{"ja":"\u307c\u3063\u3061\u602a\u7269\u3068\u76f2\u76ee\u5c11\u5973"},{"zh":"\u5b64\u72ec\u602a\u7269\u4e0e\u76f2\u5c11\u5973"},{"zh-hk":"\u5b64\u7368\u602a\u7269\u8207\u76f2\u5c11\u5973"},{"pl":"Samotna Bestia i Niewidoma Dziewczyna"},{"pt-br":"O Monstro Solit\u00e1rio e a Garota Cega"},{"en":"Lonely Monster and Blind Girl"}],"description":{"en":"A lonely monster, living in seclusion in the forest, wishes she could live amidst humans despite her frightening appearance. \nEverything changes when she starts getting a visitor\u2013a blind human girl who\u2019s fascinated with her mysterious forest friend. \nAs the monster and the girl grow attached in their secluded world, their love proves that beauty is in the eye of the beholder.","pt-br":"Nas profundezas de uma floresta, uma garota-fera vive seus dias solit\u00e1ria, at\u00e9 que um dia ela encontra uma invasora, \numa jovem mo\u00e7a cega que acaba adentrando a floresta atra\u00edda pelas flores. \nPela primeira vez um humano n\u00e3o sentiu medo e demonstrou ser gentil com ela.\nEncantada pela situa\u00e7\u00e3o, a fera mente e come\u00e7a a se encontrar com a jovem, contando-lhe hist\u00f3rias e aventuras. \nE aos poucos, essa conex\u00e3o especial come\u00e7a a aquecer o cora\u00e7\u00e3o dessa fera solit\u00e1ria."},"isLocked":false,"links":{"al":"107898","kt":"41290","mu":"1v3wd1r","mal":"113500","raw":"https:\/\/sevenseasentertainment.com\/books\/beauty-and-the-beast-girl\/"},"officialLinks":null,"originalLanguage":"ja","lastVolume":"","lastChapter":"50","publicationDemographic":"shounen","status":"completed","year":2017,"contentRating":"suggestive","tags":[{"id":"423e2eae-a7a2-4a8b-ac03-a8351462d71d","type":"tag","attributes":{"name":{"en":"Romance"},"description":{},"group":"genre","version":1},"relationships":[]},{"id":"4d32cc48-9f00-4cca-9b5a-a839f0764984","type":"tag","attributes":{"name":{"en":"Comedy"},"description":{},"group":"genre","version":1},"relationships":[]},{"id":"a3c67850-4684-404e-9b7f-c69850ee5da6","type":"tag","attributes":{"name":{"en":"Girls' Love"},"description":{},"group":"genre","version":1},"relationships":[]},{"id":"cdc58593-87dd-415e-bbc0-2ec27bf404cc","type":"tag","attributes":{"name":{"en":"Fantasy"},"description":{},"group":"genre","version":1},"relationships":[]},{"id":"dd1f77c5-dea9-4e2b-97ae-224af09caf99","type":"tag","attributes":{"name":{"en":"Monster Girls"},"description":{},"group":"theme","version":1},"relationships":[]},{"id":"e197df38-d0e7-43b5-9b09-2842d0c326dd","type":"tag","attributes":{