doujinshi"},{"id":"8420fcd6-d85c-41db-9685-b7f0c2d6f444","type":"manga","related":"doujinshi"},{"id":"96cc1b1f-a3fe-4bfe-b715-6d705a5d42ff","type":"manga","related":"doujinshi"},{"id":"97f1b530-6284-471a-9425-549b8acce615","type":"manga","related":"doujinshi"},{"id":"ae04937a-fd4a-49bb-96e2-eab37ab773c3","type":"manga","related":"doujinshi"},{"id":"b3a582f3-7be3-4996-944f-b28c7e8b82a1","type":"manga","related":"doujinshi"},{"id":"c0e93682-12f8-4786-a22c-17c9a85fd5a5","type":"manga","related":"doujinshi"},{"id":"c8d6d75d-5d43-48ac-a07e-95ba1150676c","type":"manga","related":"doujinshi"},{"id":"d0ad2534-2b28-40b9-95a8-cd2a26ad473b","type":"manga","related":"doujinshi"},{"id":"d75ea333-e068-464f-8e7e-65c8170e83f8","type":"manga","related":"doujinshi"},{"id":"dbea9894-fa8b-4d10-ac6d-0a85a1612e38","type":"manga","related":"doujinshi"},{"id":"dfc21514-f435-4779-8cd5-ca90ca6c9257","type":"manga","related":"doujinshi"},{"id":"e0a1a0bc-5edf-49d2-992e-abea45907be9","type":"manga","related":"doujinshi"},{"id":"e40e6387-4775-4e90-93bc-4df99e521594","type":"manga","related":"doujinshi"},{"id":"e557673b-9e43-4b55-ad49-cf4d2e4f6bc9","type":"manga","related":"doujinshi"},{"id":"e72797f4-6a4b-4b13-a0e7-a9cb46f4d2b7","type":"manga","related":"doujinshi"},{"id":"e7729fe3-209f-435f-a8e3-38a83006e02e","type":"manga","related":"doujinshi"},{"id":"eeeba4c1-fda6-40eb-aa65-a25073d499ab","type":"manga","related":"doujinshi"},{"id":"f8023eb4-dc6f-4195-acb4-53cb51e4769f","type":"manga","related":"doujinshi"},{"id":"f8e56358-ed18-46f0-b3bb-90c1e589b435","type":"manga","related":"doujinshi"},{"id":"f9167371-2c46-4fe7-b4a2-7f7ae5a5558d","type":"manga","related":"doujinshi"},{"id":"fd3b947b-5f6b-4759-9691-91570a152bc6","type":"manga","related":"doujinshi"},{"id":"ffb30e56-e39a-4ac5-af6c-669f93e5f2d4","type":"manga","related":"doujinshi"}]},{"id":"56901ae8-aece-4983-96c3-94751c96a8bb","type":"manga","attributes":{"title":{"ja-ro":"Bocchi the Rock! Gaiden - Hiroi Kikuri no Fukazake Nikki"},"altTitles":[{"ja":"\u307c\u3063\u3061\u30fb\u3056\u30fb\u308d\u3063\u304f\uff01\u5916\u4f1d\u3000\u5ee3\u4e95\u304d\u304f\u308a\u306e\u6df1\u9152\u65e5\u8a18"},{"en":"Bocchi the Rock! Side Story: Hiroi Kikuri's Heavy Drinking Diary"},{"ru":"\u041e\u0434\u0438\u043d\u043e\u043a\u0438\u0439 \u0420\u043e\u043a\u0435\u0440! \u0421\u043f\u0438\u043d-\u043e\u0444\u0444: \u0414\u043d\u0435\u0432\u043d\u0438\u043a \u043f\u044c\u044f\u043d\u0438\u0446\u044b \u0425\u0438\u0440\u043e\u0438 \u041a\u0438\u043a\u0443\u0440\u0438"},{"es-la":"Bocchi the Rock! Gaiden: El diario de borrachera de Kikuri Hiroi"},{"vi":"Bocchi the Rock! Ngo\u1ea1i Truy\u1ec7n: Nh\u1eadt K\u00fd Say R\u01b0\u1ee3u c\u1ee7a Hiroi Kikuri"}],"description":{"en":"25 years old Kikuri Hiroi is a \"genius bassist\" who leads the indie band \"SICK HACK\" and loves alcohol. \nShe often gets drunk and breaks the equipment inside concert clubs, so she's often short of money. \nLiving in a 52-year-old bathless apartment sometimes forces her to borrow showers from her friends. \nRegularly attacked by anxiety about her future, she counters that with a alcohol-fueled \"happiness spiral\". \nWhat is her daily life like...!?","ja":"\u4e3b\u4eba\u516c\u306f\u5ee3\u4e95\u304d\u304f\u308a\uff08\uff12\uff15\u6b73\uff09\u3002\u672c\u7de8\u3067\u300c\u307c\u3063\u3061\u3061\u3083\u3093\u300d\u3053\u3068\u5f8c\u85e4\u3072\u3068\u308a\u304b\u3089\u300c\u304a\u59c9\u3055\u3093\u300d\u3068\u6155\u308f\u308c\u308b\u5f7c\u5973\u306f\u3082\u3068\u3082\u3068\u9670\u30ad\u30e3\u3060\u3063\u305f\u304c\u3001\u30d0\u30f3\u30c9\u6d3b\u52d5\u306b\u3088\u308a\u30ab\u30ea\u30b9\u30de\u3042\u3075\u308c\u308b\u5b58\u5728\u306b\u3002\u73fe\u5728\u306f\u304a\u9152\u3092\u3053\u3088\u306a\u304f\u611b\u3057\u3001\u3088\u304f\u9154\u3063\u6255\u3063\u3066\u3044\u308b\u3002\u306f\u305f\u3057\u3066\u5f7c\u5973\u306e\u65e5\u5e38\u3068\u306f\u2026\u2026\uff01\uff1f","vi":"Kikuri Hiroi -\"tay bass thi\u00ean t\u00e0i\" c\u1ee7a SICK HACK, n\u1ed7i kinh ho\u00e0ng c\u1ee7a c\u00e1c \u0111\u1ecba \u0111i\u1ec3m h\u00f2a nh\u1ea1c, k\u1ebb \u0103n h\u1ea1i quanh n\u0103m su\u1ed1t th\u00e1ng, v\u00e0 h\u00ecnh m\u1eabu t\u1ec7 n\u1ea1n to\u00e0n di\u1ec7n - t\u1eeb l\u00e2u \u0111\u00e3 cho r\u1eb1ng kh\u00f4ng c\u00f3 v\u1ea5n \u0111\u1ec1 n\u00e0o m\u00e0 c\u00f4 kh\u00f4ng th\u1ec3 gi\u1ea3i quy\u1ebft b\u1eb1ng c\u00e1ch n\u1ed1c r\u01b0\u1ee3u. Cho d\u00f9 \u0111\u00f3 l\u00e0 n\u1ec1n kinh t\u1ebf \u0111ang suy tho\u00e1i, h\u00f3a \u0111\u01a1n ti\u1ec1n thu\u00ea nh\u00e0 qu\u00e1 h\u1ea1n, hay ch\u1ec9 \u0111\u01a1n gi\u1ea3n l\u00e0 ch\u1ee9ng lo \u00e2u x\u00e3 h\u1ed9i lu\u00f4n ch\u1ef1c ch\u1edd trong \u0111\u1ea7u, ch\u1ec9 m\u1ed9t c\u01a1n say v\u1edbi v\u00f2ng tr\u00f2n h\u1ea1nh ph\u00fac s\u1ebd gi\u00fap m\u1ecdi chuy\u1ec7n t\u1ef1 gi\u1ea3i quy\u1ebft ch\u00ednh n\u00f3... ph\u1ea3i kh\u00f4ng? Ch\u1eafc ch\u1eafn cu\u1ed9c s\u1ed1ng th\u01b0\u1eddng ng\u00e0y c\u1ee7a c\u00f4 \u1ea5y kh\u00f4ng ph\u1ea3i l\u00e0  th\u1ea3m h\u1ecda, ph\u1ea3i kh\u00f4ng?!","es-la":"Kikuri Hiroi, de 25 a\u00f1os, es una bajista prodigiosa que lidera la banda indie \"SICK HACK\" y le encanta el alcohol. A menudo se emborracha y rompe el equipo en los locales de conciertos, por lo que suele andar corta de dinero. Vive en un apartamento de 52 a\u00f1os sin ba\u00f1o, as\u00ed que a veces pide prestada la ducha a sus amigos. Constantemente atormentada por la ansiedad sobre su futuro, la contrarresta con una espiral de felicidad alimentada por el alcohol. \u00bfC\u00f3mo es su d\u00eda a d\u00eda...?"},"isLocked":false,"links":{"al":"163400","ap":"bocchi-the-rock-gaiden-hiroi-kikuri-no-fukazake-nikki","bl":"1494030","bw":"series\/452628","kt":"67257","mu":"b5lljv5","amz":"https:\/\/www.amazon.co.jp\/dp\/B0CW18P64G","cdj":"https:\/\/www.cdjapan.co.jp\/product\/NEOBK-2957616","ebj":"https:\/\/ebookjapan.yahoo.co.jp\/books\/808164","mal":"159093","raw":"https:\/\/comic-fuz.com\/manga\/3354","engtl":"https:\/\/yenpress.com\/series\/bocchi-the-rock-side-story-kikuri-hiroi-s-heavy-drinking-diary"},"officialLinks":null,"originalLanguage":"ja","lastVolume":"","lastChapter":"","publicationDemographic":"seinen","status":"ongoing","year":2023,"contentRating":"safe","tags":[{"id":"4d32cc48-9f00-4cca-9b5a-a839f0764984","type":"tag","attributes":{"name":{"en":"Comedy"},"description":{},"group":"genre","version":1},"relationships":[]},{"id":"5fff9cde-849c-4d78-aab0-0d52b2ee1d25","type":"tag","attributes":{"name":{"en":"Survival"},"description":{},"group":"theme","version":1},"relationships":[]},{"id":"e5301a23-ebd9-49dd-a0cb-2add944c7fe9","type":"tag","attributes":{"name":{"en":"Slice of Life"},"description":{},"group":"genre","version":1},"relationships":[]},{"id":"f42fbf9e-188a-447b-9fdc-f19dc1e4d685","type":"tag","attributes":{"name":{"en":"Music"},"description":{},"group":"theme","version":1},"relationships":[]}],"state":"published","chapterNumbersResetOnNewVolume":false,"createdAt":"2023-06-09T18:21:20+00:00","updatedAt":"2026-09-22T01:00:12+00:00","version":48,"availableTranslatedLanguages":["ru","pt-br","es-la","id","vi","en","fr","tr"],"latestUploadedChapter":"f597a4a1-d52f-472d-a27c-012c757e233f"},"relationships":[{"id":"e878caa1-b648-49fd-983c-e9d7f7231258","type":"author"},{"id":"e878caa1-b648-49fd-983c-e9d7f7231258","type":"artist"},{"id":"accc1594-6fd7-4560-917e-4ee4bbb0f013","type":"cover_art","attributes":{"description":"https:\/\/x.com\/COMICFUZ\/status\/2053127853513036109","volume":"7","fileName":"7d6eaa69-c617-4668-a35c-64be173c4745.jpg","locale":"ja","createdAt":"2026-05-15T11:35:16+00:00","updatedAt":"2026-05-15T11:35:16+00:00","version":1}},{"id":"2e0fdb3b-632c-4f8f-a311-5b56952db647","type":"manga","related":"main_story"},{"id":"50cc9825-359d-4132-9e68-e5e875d38d94","type":"creator"}]},{"id":"86d25eac-eb2f-4ec0-a341-f1a5cbbe80b8","type":"manga","attributes":{"title":{"ja-ro":"Douka Ore o Houtte Oitekure: Nazeka Bocchi no Owatta Koukou Seikatsu o Kanojo ga Kaeyou to shitekuru"},"altTitles":[{"ja":"\u3069\u3046\u304b\u4ffa\u3092\u653e\u3063\u3066\u304a\u3044\u3066\u304f\u308c\u3000\u306a\u305c\u304b\u307c\u3063\u3061\u306e\u7d42\u308f\u3063\u305f\u9ad8\u6821\u751f\u6d3b\u3092\u5f7c\u5973\u304c\u5909\u3048\u3088\u3046\u3068\u3057\u3066\u304f\u308b"},{"en":"Let Me Be Single in Peace!"},{"zh":"\u6c42\u4f60\u522b\u6765\u7ba1\u6211\u4e86"}],"description":{"en":"Love, friendship, and a glorious adolescence\u2014that's what Hodoka Nanamura hoped for when he entered high school. But by his final year, he had none of it. Then, on the eve of graduation, he sacrifices himself to save his classmate, Sora Hanamitsuji, from on oncoming truck, ending his life... or so it should have. Instead, he and Hanamitsuji were both transported back in time to their first year of high school, just before the entrance ceremony. Though Nanamura resigned himself to reliving the same unremarkable, lonely high school years, Hanamitsuji swears that she'll drag him out of his loner lifestyle!\n\n*Source: Manga UP! Global*","ja":"\u604b\u3001\u53cb\u60c5\u3001\u8f1d\u304b\u3057\u3044\u9752\u6625\u3002\u305d\u3093\u306a\u671f\u5f85\u306b\u80f8\u3092\u81a8\u3089\u307e\u305b\u305f\u4ffa\u306e\u9ad8\u6821\u751f\u6d3b\u306f\u2015\u2015\u7d50\u5c40\u307c\u3063\u3061\u306e\u307e\u307e\u7d42\u308f\u3063\u305f\u3002\u305d\u3057\u3066\u8fce\u3048\u305f\u5352\u696d\u5f0f\u524d\u65e5\u3002\u30af\u30e9\u30b9\u30e1\u30a4\u30c8\u306e\u82b1\u898b\u8fbb\u7a7a\u3092\u304b\u3070\u3044\u3001\u4ffa\u306f\u30c8\u30e9\u30c3\u30af\u306b\u8f62\u304b\u308c\u3066\u4eba\u751f\u306e\u5e55\u3092\u9589\u3058\u305f\u2026\u2026\u306f\u305a\u3060\u3063\u305f\u3002\u82b1\u898b\u8fbb\u3068\u4e00\u7dd2\u306b\u9ad8\u6821\u4e00\u5e74\u751f\u306e\u5165\u5b66\u5f0f\u306b\u623b\u3063\u3066\u3057\u307e\u3063\u305f\u4ffa\u3002\u4e8c\u5ea6\u76ee\u306e\u9ad8\u6821\u751f\u6d3b\u306f\u8f1d\u304b\u3057\u3044\u9752\u6625\u306a\u3069\u671f\u5f85\u305b\u305a\u5927\u4eba\u3057\u304f\u307c\u3063\u3061\u3067\u904e\u3054\u305d\u3046\u3068\u601d\u3044\u304d\u3084\u2026\u2026\u3002\u300c\u307c\u3063\u3061\u8131\u5374\u3001\u79c1\u304c\u624b\u4f1d\u3063\u3066\u3042\u3052\u308b\u300d"},"isLocked":false,"links":{"al":"151360","ap":"douka-ore-wo-hanatte-oitekure-naze-ka-bocchi-no-owatta-koukou-seikatsu-wo-kanojo-ga-kaeyou-to-shitekuru","bl":"20050779","bw":"series\/379160\/list","kt":"65038","mu":"4a0vvb0","nu":"please-leave-me-alone","amz":"https:\/\/www.amazon.co.jp\/dp\/B0BKFX1DSN","ebj":"https:\/\/ebookjapan.yahoo.co.jp\/books\/729239","mal":"151183","raw":"https:\/\/www.ganganonline.com\/title\/1581","engtl":"https:\/\/global.manga-up.com\/manga\/637"},"officialLinks":null,"originalLanguage":"ja","lastVolume":"","lastChapter":"","publicationDemographic":"shounen","status":"ongoing","year":2022,"contentRating":"safe","tags":[{"id":"292e862b-2d17-4062-90a2-0356caa4ae27","type":"tag","attributes":{"name":{"en":"Time Travel"},"description":{},"group":"theme","version":1},"relationships":[]},{"id":"423e2eae-a7a2-4a8b-ac03-a8351462d71d","type":"tag","attributes":{"name":{"en":"Romance"},"description":{},"group":"genre","version":1},"relationships":[]},{"id":"4d32cc48-9f00-4cca-9b5a-a839f0764984","type":"tag","attributes":{"name":{"en":"Comedy"},"description":{},"group":"genre","version":1},"relationships":[]},{"id":"b9af3a63-f058-46de-a9a0-e0c13906197a","type":"tag","attributes":{"name":{"en":"Drama"},"description":{},"group":"genre","version":1},"relationships":[]},{"id":"caaa44eb-cd40-4177-b930-79d3ef2afe87","type":"tag","attributes":{"name":{"en":"School Life"},"description":{},"group":"theme","version":1},"relationships":[]},{"id":"e5301a23-ebd9-49dd-a0cb-2add944c7fe9","type":"tag","attributes":{"name":{"en":"Slice of Life"},"description":{},"group":"genre","version":1},"relationships":[]},{"id":"eabc5b4c-6aff-42f3-b657-3e90cbd00b75","type":"tag","attributes":{"name":{"en":"Supernatural"},"description":{},"group":"theme","version":1},"relationships":[]},{"id":"f4122d1c-3b44-44d0-9936-ff7502c39ad3","type":"tag","attributes":{"name":{"en":"Adaptation"},"description":{},"group":"format","version":1},"relationships":[]}],"state":"published","chapterNumbersResetOnNewVolume":false,"createdAt":"2022-08-29T00:59:33+00:00","updatedAt":"2026-07-03T14:42:41+00:00","version":43,"availableTranslatedLanguages":["en","vi","zh","ru"],"latestUploadedChapter":"3bf5e1f1-07ed-4228-ba53-5fd4b07a8391"},"relationships":[{"id":"5ebe360e-0596-4d06-bdbd-dc16c1ad5b62","type":"author"},{"id":"b3f895a4-aae7-40fd-a191-88117aaefc2c","type":"author"},{"id":"3f6a10d8-5b6b-4f41-8932-8df6ff8b0962","type":"artist"},{"id":"5ebe360e-0596-4d06-bdbd-dc16c1ad5b62","type":"artist"},{"id":"a0a751b1-01e4-40ae-bf3e-18147733a476","type":"cover_art","attributes":{"description":"","volume":"6","fileName":"28a5585c-cc55-457f-9c3e-310061d83f15.jpg","locale":"ja","createdAt":"2026-02-04T08:33:38+00:00","updatedAt":"2026-02-04T08:33:38+00:00","version":1}},{"id":"fe9c8430-52cf-4173-a87d-89a786fbeb49","type":"creator"}]},{"id":"fc7e628c-6c26-497a-b17d-dfea90b44652","type":"manga","attributes":{"title":{"ja-ro":"Bocchi no Boku ni Kyousei Kanojo ga Yattekita"},"altTitles":[{"ja":"\u307c\u3063\u3061\u306e\u50d5\u306b\u5f37\u5236\u5f7c\u5973\u304c\u3084\u3063\u3066\u304d\u305f"},{"en":"A Girlfriend Was Forced Upon Me, The Forever Loner"},{"en":"I\u2019m a Loner and My Girlfriend Came to Me by Force"},{"vi":"B\u1ea1n G\u00e1i B\u1ea5t \u0110\u1eafc D\u0129 C\u1ee7a C\u00f4 \u0110\u1ed9c V\u01b0\u01a1ng"}],"description":{"en":"On my 24th birthday, I came home to find a woman who wanted to be my girlfriend! As a \"loner\" since junior high school, I was confused by all this. But the truth is she is my mother's junior at work, and my mother asked her to!? A pseudo-romance between two people with the same interests has begun!","ja":"\u4e2d\u5b66\u6642\u4ee3\u304b\u3089\u201c\u307c\u3063\u3061\u201d\u306a\u5468\u5e73\u306f\u3001\u5fc5\u8981\u4ee5\u4e0a\u306b\u4eba\u3068\u4ea4\u308f\u3089\u305a\u8a71\u3055\u306a\u3044\u3002\u305d\u3093\u306a\u5468\u5e73\u304c24\u6b73\u3092\u8fce\u3048\u305f\u8a95\u751f\u65e5\u3001\u81ea\u5b85\u306e\u98df\u5353\u306b\u898b\u77e5\u3089\u306c\u5973\u6027\u304c\uff01\uff1f","vi":"V\u00e0o sinh nh\u1eadt l\u1ea7n th\u1ee9 24, t\u00f4i v\u1ec1 nh\u00e0 v\u00e0 ph\u00e1t hi\u1ec7n m\u1ed9t c\u00f4 g\u00e1i \u0111ang ch\u1edd m\u00ecnh, c\u00f2n mu\u1ed1n tr\u1edf th\u00e0nh b\u1ea1n g\u00e1i c\u1ee7a t\u00f4i!\n\nL\u00e0 m\u1ed9t \u201ck\u1ebb c\u00f4 \u0111\u1ed9c\u201d t\u1eeb h\u1ed3i c\u1ea5p hai, t\u00f4i ch\u1eb3ng bi\u1ebft ph\u1ea3i ph\u1ea3n \u1ee9ng th\u1ebf n\u00e0o tr\u01b0\u1edbc chuy\u1ec7n n\u00e0y. Nh\u01b0ng s\u1ef1 th\u1eadt l\u00e0 c\u00f4 \u1ea5y l\u1ea1i l\u00e0 h\u1eadu b\u1ed1i c\u1ee7a m\u1eb9 t\u00f4i \u1edf ch\u1ed7 l\u00e0m, v\u00e0 ch\u00ednh m\u1eb9 t\u00f4i \u0111\u00e3 nh\u1edd c\u00f4 \u1ea5y l\u00e0m v\u1eady!?\n\nM\u1ed9t m\u1ed1i t\u00ecnh gi\u1ea3 gi\u1eefa hai con ng\u01b0\u1eddi c\u00f3 c\u00f9ng s\u1edf th\u00edch ch\u00ednh th\u1ee9c b\u1eaft \u0111\u1ea7u!","pt-br":"No meu 24\u00ba anivers\u00e1rio, voltei para casa para encontrar uma mulher que queria ser minha namorada! Como \"solit\u00e1rio\" desde o ensino m\u00e9dio, fiquei confuso com tudo isto, mas a verdade \u00e9 que ela \u00e9 a kohai da minha m\u00e3e no trabalho, e a minha m\u00e3e lhe pediu que o fizesse! Se inicia ent\u00e3o umm pseudo-romance entre duas pessoas com os mesmos interesses!"},"isLocked":false,"links":{"al":"136994","ap":"a-girlfriend-was-forced-upon-me-the-forever-loner","bl":"1047427","bw":"series\/331603\/list","kt":"64340","mu":"jnz4kbu","amz":"https:\/\/www.amazon.co.jp\/dp\/B0D8HFH3SD","cdj":"https:\/\/www.cdjapan.co.jp\/product\/NEOBK-2675724","ebj":"https:\/\/ebookjapan.yahoo.co.jp\/books\/672453","mal":"141738","raw":"https:\/\/comic-trail.com\/episode\/3269632237330707078","engtl":"https:\/\/mangaplaza.com\/title\/0303005553"},"officialLinks":null,"originalLanguage":"ja","lastVolume":"","lastChapter":"","publicationDemograp