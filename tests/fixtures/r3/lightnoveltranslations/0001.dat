		<script id="lnt-reader-font-size">
(function () {
    'use strict';
    if (window.LNTReaderPreferences) return; // LNT_READER_V2_GUARD
    var key = 'lnt.reader.fontSize.v1';
    var minimum = 8;
    var maximum = 72;
    var controls = '.plus_content, .minus_content, .copy_content';
    var entries = [];
    var defaultSize;
    var currentSize;

    function readSize() {
        try {
            var value = window.localStorage.getItem(key);
            var size = value === null || value === '' ? NaN : Number(value);
            return isFinite(size) && size >= minimum && size <= maximum ? size : null;
        } catch (error) {
            return null; // Reading controls still work when storage is unavailable.
        }
    }

    function apply(size) {
        currentSize = size === null ? defaultSize : size;
        var delta = currentSize - defaultSize;
        entries.forEach(function (entry) {
            if (size === null) {
                if (entry.inline) {
                    entry.node.style.setProperty('font-size', entry.inline, entry.priority);
                } else {
                    entry.node.style.removeProperty('font-size');
                }
            } else {
                entry.node.style.setProperty('font-size', Math.max(minimum, entry.base + delta) + 'px', entry.priority);
            }
        });
    }

    function initialize() {
        var stories = document.querySelectorAll('.text_story');
        if (!stories.length) { return; }
        var sample = stories[0].querySelector('p') || stories[0];
        defaultSize = parseFloat(window.getComputedStyle(sample).fontSize) || 16;
        currentSize = defaultSize;
        // Read original sizes together, before writing styles, to avoid repeated layout work.
        Array.prototype.forEach.call(stories, function (story) {
            var nodes = [story].concat(Array.prototype.slice.call(story.querySelectorAll('p, div, span, a, strong, b, em, i, u, s, del, small, sub, sup, li, ul, ol, blockquote, pre, code, h1, h2, h3, h4, h5, h6')));
            nodes.forEach(function (node) {
                if (node.closest('ins, iframe, .lnt-ad')) { return; }
                entries.push({
                    node: node,
                    base: parseFloat(window.getComputedStyle(node).fontSize) || defaultSize,
                    inline: node.style.getPropertyValue('font-size'),
                    priority: node.style.getPropertyPriority('font-size')
                });
            });
        });
        Array.prototype.forEach.call(document.querySelectorAll(controls), function (control) {
            // The theme's class names are reversed: minus_content displays the A+ icon.
            var label = control.classList.contains('copy_content') ? 'Reset font size' :
                control.classList.contains('minus_content') ? 'Increase font size' : 'Decrease font size';
            control.setAttribute('aria-label', label);
            control.setAttribute('title', label);
        });
        var saved = readSize();
        if (saved !== null) { apply(saved); }

        // Capture only these controls so a cached copy of the old custom.js cannot resize twice.
        document.addEventListener('click', function (event) {
            var control = event.target.closest && event.target.closest(controls);
            if (!control) { return; }
            event.preventDefault();
            event.stopImmediatePropagation();
            var reset = control.classList.contains('copy_content');
            var size = reset ? null : Math.max(minimum, Math.min(maximum,
                currentSize + (control.classList.contains('minus_content') ? 1 : -1)));
            apply(size);
            try {
                if (reset) { window.localStorage.removeItem(key); }
                else { window.localStorage.setItem(key, String(size)); }
            } catch (error) { /* Keep the controls usable if storage is blocked or full. */ }
        }, true);

        window.addEventListener('pageshow', function (event) {
            if (event.persisted) { apply(readSize()); }
        });
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initialize, { once: true });
    } else {
        initialize();
    }
}());

		</script> 
