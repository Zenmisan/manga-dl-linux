<script id="lnt-presentation-batch-js">(function () {
    'use strict';
    function initialize() {
        const header = document.getElementById('header-wrapper');
        const menu = document.getElementById('lnt-mobile-menu');
        if (header && menu) {
            // Move the existing elements, retaining their URLs and event handlers.
            // Reader pages already perform these moves in reader.js.
            if (!document.body.classList.contains('lnt-reader-page')) {
                const utilities = header.querySelector('.mobile_vip_view_mode');
                const account = header.querySelector('.mobile_krystal_user');
                if (utilities) { utilities.classList.add('lnt-reader-menu-utilities'); menu.append(utilities); }
                if (account) { account.classList.add('lnt-reader-menu-account'); menu.prepend(account); }
            }
            header.querySelectorAll('.mini-shopping-cart').forEach(link => link.setAttribute('aria-label', 'Shopping cart'));
            header.querySelectorAll('.search_field').forEach(field => { if (!field.getAttribute('aria-label')) field.setAttribute('aria-label', 'Search novels'); });
            document.body.classList.add('lnt-mobile-header-ready');
        }
        document.querySelectorAll('.single-novels-parent-page .novel-info').forEach(info => {
            const title = info.querySelector('.novel_title');
            const action = info.querySelector('.lnt-reading-action');
            if (title && action) title.after(action);
        });
    }
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', initialize, { once:true });
    else initialize();
}());
</script> 
