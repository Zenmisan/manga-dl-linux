<style>
.lnt-browse{--lb-bg:#fff;--lb-page:#f6f6fc;--lb-text:#202730;--lb-muted:#535f70;--lb-line:#d9e1e9;--lb-soft:#edf7fc;--lb-accent:#0079a5;color:var(--lb-text);background:var(--lb-page)}
.lnt-b-warning-label{font-size:12px;color:var(--lb-muted);margin:4px 0 8px}
body.night_mode .lnt-browse{--lb-bg:#1b232e;--lb-page:#1f222a;--lb-text:#f0f4f8;--lb-muted:#b8c4d2;--lb-line:#455365;--lb-soft:#243947;--lb-accent:#65d3ff}
.lnt-browse .lnt-b-top{padding:26px 0 24px}.lnt-browse h1{font-size:30px;line-height:1.25;margin:0 0 8px;text-transform:none}.lnt-b-intro{color:var(--lb-muted);margin:0 0 22px}
.lnt-b-form{padding:24px;background:var(--lb-bg);border:1px solid var(--lb-line);border-radius:12px}.lnt-b-form label:not(.lnt-b-check),.lnt-b-field-label{display:block;font-size:13px;font-weight:700;margin:0 0 8px}
.lnt-b-search-row{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:12px;margin-bottom:20px}.lnt-browse input[type=search],.lnt-browse select{width:100%;min-width:0;height:46px;border:1px solid var(--lb-line);border-radius:7px;padding:10px 12px;background:var(--lb-bg);color:var(--lb-text);font:inherit;font-size:14px}.lnt-browse input::placeholder{color:var(--lb-muted);opacity:1}
.lnt-b-primary{display:inline-flex;align-items:center;justify-content:center;gap:12px;min-height:44px;padding:11px 20px;border:0;border-radius:6px;background:#008abd;color:#fff!important;font-size:14px;font-weight:700;line-height:1.4;text-decoration:none;cursor:pointer}.lnt-b-primary:hover{background:#006e97}.lnt-browse a{color:var(--lb-accent)}.lnt-browse :is(a,button,input,select,summary):focus-visible{outline:3px solid var(--lb-accent);outline-offset:3px}
.lnt-b-filter-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:16px}.lnt-b-genre-field{position:relative}.lnt-b-genres>summary{list-style:none;min-height:46px;border:1px solid var(--lb-line);border-radius:7px;padding:11px 12px;display:flex;justify-content:space-between;align-items:center;gap:8px;font-size:14px;cursor:pointer}.lnt-b-genres>summary::-webkit-details-marker{display:none}.lnt-b-genre-menu{position:absolute;left:0;top:100%;z-index:20;width:min(620px,70vw);padding:16px;background:var(--lb-bg);border:1px solid var(--lb-line);border-radius:8px;box-shadow:0 8px 24px #0002}.lnt-b-genre-menu p,.lnt-b-more p{margin:0 0 10px;color:var(--lb-muted);font-size:13px}
.lnt-b-checks{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:4px 12px}.lnt-b-genre-menu .lnt-b-checks,.lnt-b-exclude{max-height:320px;overflow:auto;overscroll-behavior:contain}.lnt-b-check{display:flex!important;align-items:center;gap:9px;min-height:40px;font-size:13px!important;line-height:1.4;margin:0!important;padding:5px 2px;cursor:pointer;overflow-wrap:anywhere}.lnt-b-check input{position:static!important;appearance:auto!important;opacity:1!important;width:17px!important;height:17px!important;flex:0 0 17px;margin:0!important;accent-color:#008abd}.lnt-b-check span{color:var(--lb-text)}
.lnt-b-more{margin-top:18px;border-top:1px solid var(--lb-line);padding-top:14px}.lnt-b-more>summary{cursor:pointer;font-size:13px;min-height:36px;color:var(--lb-accent);font-weight:600}.lnt-b-more-body{padding:14px 0 0}.lnt-b-more fieldset{border:0;padding:0;margin:0 0 20px;min-width:0}.lnt-b-more legend{font-size:14px;font-weight:700;margin-bottom:10px;color:var(--lb-text)}.lnt-b-actions{display:flex;align-items:center;gap:18px;flex-wrap:wrap;margin-top:14px}.lnt-b-clear{display:inline-flex;align-items:center;min-height:44px;font-size:14px;font-weight:600}.lnt-b-actions>span{font-size:12px;color:var(--lb-muted)}.lnt-b-filter-toggle{display:none}
.lnt-b-results{padding:8px 0 40px}.lnt-b-results-heading{display:flex;justify-content:space-between;gap:12px;align-items:baseline;margin-bottom:16px}.lnt-b-results-heading h2{font-size:20px;text-transform:none;line-height:1.45;margin:0}.lnt-b-results-heading>span{font-size:12px;color:var(--lb-muted);white-space:nowrap}.lnt-b-chips{display:flex;flex-wrap:wrap;gap:8px;margin:0 0 22px}.lnt-b-chips a{display:inline-flex;gap:12px;align-items:center;min-height:36px;padding:7px 12px;background:var(--lb-soft);border:1px solid var(--lb-line);border-radius:20px;font-size:12px;max-width:100%;overflow-wrap:anywhere}
.lnt-browse .read_list-story-item{display:flex;gap:24px;padding:24px 0;border-bottom:1px solid var(--lb-line);margin:0}.lnt-browse .item_thumb{width:125px;flex:0 0 125px;margin:0}.lnt-browse .item_thumb img{width:100%;height:auto;aspect-ratio:2/3;object-fit:cover;border-radius:6px}.lnt-browse .star_rate{display:block!important;text-align:center;font-size:12px;margin-top:10px;color:var(--lb-text)}.lnt-browse .wrap_item_content{flex:1;min-width:0;width:auto;padding:0}.lnt-browse .wrap_item_content h3{font-size:20px;line-height:1.4;text-transform:none;margin:0 0 10px}.lnt-browse .wrap_item_content h3 a{color:var(--lb-text)}.lnt-b-book-meta{display:flex;flex-wrap:wrap;gap:7px 14px;margin:0 0 10px;padding:0;list-style:none;color:var(--lb-muted);font-size:12px}.lnt-b-book-genres{display:flex;gap:6px 12px;flex-wrap:wrap;font-size:12px;margin-bottom:10px}.lnt-b-description{font-size:14px;line-height:1.75;color:var(--lb-muted);margin:0 0 8px}.lnt-b-view{display:inline-flex;align-items:center;gap:10px;min-height:40px;font-size:13px;font-weight:600}.lnt-b-empty{padding:40px 20px;text-align:center;background:var(--lb-bg);border:1px solid var(--lb-line);border-radius:10px}.lnt-b-empty h3{font-size:22px;text-transform:none}.lnt-b-empty p{color:var(--lb-muted)}.lnt-b-pagination{margin-top:28px}.lnt-b-pagination .page-numbers{color:var(--lb-text)}
@media(max-width:991px){.lnt-b-filter-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.lnt-b-genre-menu{left:auto;right:0;width:min(620px,75vw)}}
@media(max-width:767px){.lnt-browse .lnt-b-top{padding-top:18px}.lnt-browse h1{font-size:25px}.lnt-b-intro{font-size:13px;margin-bottom:16px}.lnt-b-form{padding:16px}.lnt-b-search-row{grid-template-columns:minmax(0,1fr);gap:10px;margin-bottom:12px}.lnt-browse input[type=search],.lnt-browse select{font-size:16px}.lnt-b-filter-toggle{display:flex;width:100%;align-items:center;gap:7px;min-height:44px;padding:10px 0;color:var(--lb-accent);border:0;background:none;font-weight:700;text-align:left}.lnt-b-filter-toggle>span:last-child{margin-left:auto}.lnt-browse-ready #lnt-b-controls.is-collapsed{display:none}.lnt-b-filter-grid{gap:14px 10px;margin-top:10px}.lnt-b-genre-menu{position:static;width:100%;padding:10px;margin-top:6px;box-shadow:none}.lnt-b-genre-menu .lnt-b-checks{grid-template-columns:1fr;max-height:270px}.lnt-b-checks{grid-template-columns:repeat(2,minmax(0,1fr))}.lnt-b-check{min-height:44px}.lnt-b-actions{gap:12px}.lnt-b-actions>span{flex-basis:100%}.lnt-b-results-heading{display:block}.lnt-b-results-heading h2{font-size:18px;margin-bottom:5px}.lnt-browse .read_list-story-item{gap:14px;padding:20px 0}.lnt-browse .item_thumb{width:85px;flex-basis:85px}.lnt-browse .wrap_item_content h3{font-size:16px}.lnt-b-description{font-size:13px;line-height:1.65;display:-webkit-box;-webkit-line-clamp:4;-webkit-box-orient:vertical;overflow:hidden}.lnt-b-book-meta{font-size:11px}.lnt-b-chips a{min-height:44px}.lnt-browse .star_rate{font-size:11px}}
@media(prefers-reduced-motion:reduce){.lnt-browse *{scroll-behavior:auto!important}}
</style>
<script>
(function(){
var form=document.getElementById('lnt-b-form'),toggle=form.querySelector('.lnt-b-filter-toggle'),panel=document.getElementById('lnt-b-controls'),genres=form.querySelector('.lnt-b-genres');
form.classList.add('lnt-browse-ready');
if(window.matchMedia('(max-width:767px)').matches){panel.classList.add('is-collapsed');toggle.setAttribute('aria-expanded','false');}
toggle.addEventListener('click',function(){var closed=panel.classList.toggle('is-collapsed');toggle.setAttribute('aria-expanded',String(!closed));});
form.addEventListener('change',function(e){
 var x=e.target, pairs={'tag_name[]':'exclude_genres[]','exclude_genres[]':'tag_name[]','content_warning_search_value[]':'hide_content[]','hide_content[]':'content_warning_search_value[]'};
 if(x.checked && pairs[x.name]){Array.prototype.forEach.call(form.elements,function(other){if(other.name===pairs[x.name]&&other.value===x.value)other.checked=false;});}
 var included=form.querySelectorAll('input[name="tag_name[]"]:checked').length,count=form.querySelectorAll('input[type=checkbox]:checked').length+(form.elements.status.value!=='all'?1:0)+(form.elements.type.value!=='all'?1:0);
 document.getElementById('lnt-b-genre-summary').textContent=included?included+' selected':'All genres';document.getElementById('lnt-b-filter-count').textContent=count?'('+count+')':'';
});
document.addEventListener('click',function(e){if(!genres.contains(e.target))genres.open=false;});
genres.addEventListener('keydown',function(e){if(e.key==='Escape'){genres.open=false;genres.querySelector('summary').focus();}});
}());
</script>
