(function () {
    try {
        var settings = JSON.parse(localStorage.getItem('settings_v2')).state;
        var palette = settings.theme === 'custom' ? settings.customThemePalette : null;
        if (!palette && ['main', 'dark', 'light'].indexOf(settings.theme) < 0) return;
        var root = document.documentElement;
        var tone = (palette ? palette.tone : settings.theme) === 'light' ? 'light' : 'dark';
        root.setAttribute('data-theme', settings.theme);
        root.setAttribute('data-tone', tone);
        root.style.setProperty('color-scheme', tone);
        for (var name in palette ? palette.variables : {}) {
            if (name.indexOf('--') === 0) root.style.setProperty(name, palette.variables[name]);
        }
    } catch (error) {}
})();
